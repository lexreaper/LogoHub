FROM python:3.13-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

COPY requirements.notifications.txt .
RUN python -m pip install --no-cache-dir -r requirements.notifications.txt

COPY services/__init__.py ./services/
COPY services/notifications/__init__.py services/notifications/server.py ./services/notifications/

CMD ["python", "-m", "uvicorn", "services.notifications.server:app", "--host", "0.0.0.0", "--port", "8001"]